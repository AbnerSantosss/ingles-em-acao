# ------------------------------------------------------------------------------
# "Inglês em Ação" — modelo de variáveis de ambiente
#
# DESENVOLVIMENTO: copie este arquivo para `.env` (`cp .env.example .env`) e ajuste.
# PRODUÇÃO: NÃO use arquivo .env. Cadastre cada variável no ambiente da stack do
#           Portainer — passo a passo em docs/DEPLOY.md.
#
# Nenhum valor aqui é real. Nunca comite o `.env`.
# ------------------------------------------------------------------------------

# --- Banco de dados ---------------------------------------------------------
# Desenvolvimento: o Postgres sobe com `docker compose up -d db` e escuta em 5433
# (veja docker-compose.yml) para não brigar com um Postgres local na 5432.
DATABASE_URL="postgresql://wsa:wsa_dev_password@localhost:5433/wsa_english?schema=public"
# Produção (dentro da stack, o host é o nome do serviço `db` e a porta é 5432):
# DATABASE_URL="postgresql://iea:SENHA_FORTE@db:5432/ingles_em_acao?schema=public&connection_limit=10"

# --- App --------------------------------------------------------------------
# URL pública, sem barra no final. Usada nos links dos e-mails de verificação e de
# redefinição de senha. Em produção precisa ser https:// (o cookie de sessão é `secure`).
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Porta em que o servidor escuta dentro do container/processo.
PORT="3000"
# Fuso horário — afeta a contagem de dias de estudo (streak).
TZ="America/Sao_Paulo"

# --- E-mail (SMTP do Gmail) -------------------------------------------------
# Com Gmail é obrigatório usar uma SENHA DE APP (conta com verificação em duas etapas
# ligada → Segurança → Senhas de app). A senha normal da conta não funciona.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="sua-senha-de-app-do-gmail"
MAIL_FROM="Inglês em Ação <seu-email@gmail.com>"

# --- Biblioteca de mídia (imagens das aulas) --------------------------------
# Onde ficam os arquivos enviados pelo painel (/admin/midia). Decisão D6: volume
# Docker, não bucket — são ~150 imagens e um volume nomeado sobrevive a redeploy.
#   volume = disco (padrão)      s3 = bucket (adapter ainda não existe; o app recusa subir)
MEDIA_STORAGE="volume"
# Pasta raiz dos uploads. Em desenvolvimento, deixe em branco/comentado: o padrão é
# `var/uploads/` na raiz do projeto (mantenha essa pasta FORA do Git).
# Em produção é o ponto de montagem do volume iea_uploads: /app/var/uploads
# MEDIA_ROOT="/app/var/uploads"

# --- Vídeos enviados pelo painel (/admin/videos → "Enviar arquivo") ---------
# Bucket S3-compatível — recomendado: Cloudflare R2 (sem custo de saída). Vale SÓ
# para vídeo: as imagens continuam no volume acima. Vídeo NUNCA vai para o volume
# (D6): o navegador do admin envia direto ao bucket, e o aluno assiste por link
# assinado de 15 minutos. Sem estas quatro variáveis, a opção "Enviar arquivo" do
# painel diz o que falta e o painel segue aceitando só link (YouTube/Vimeo).
# O bucket precisa de CORS liberando PUT a partir do APP_URL — ver docs/DEPLOY.md.
#   R2: S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com" (sem o nome do bucket)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Opcional. No R2 é sempre "auto" (o padrão). Na AWS, a região do bucket (ex.: sa-east-1).
# S3_REGION="auto"

# ------------------------------------------------------------------------------
# Somente produção (stack do Portainer, docker-compose.prod.yml)
# ------------------------------------------------------------------------------
# Credenciais do container do Postgres. A stack monta a DATABASE_URL com elas.
# Use só letras e números na senha: caracteres como @ : / ? # quebram a URL de conexão.
POSTGRES_USER="iea"
POSTGRES_PASSWORD="troque-por-uma-senha-forte-alfanumerica"
POSTGRES_DB="ingles_em_acao"

# Onde o app fica exposto no host. O padrão 127.0.0.1 deixa o app acessível apenas
# pelo próprio servidor — quem publica na internet é o proxy reverso (nginx/Traefik).
APP_BIND="127.0.0.1"
APP_PORT="3000"

# Roda o seed (módulos + 42 aulas) no start do container. Deixe "true" só no primeiro
# deploy; depois volte para "false" e faça redeploy.
RUN_SEED="false"

# Ajuste fino da espera pelo banco no start do container (opcional).
# DB_WAIT_RETRIES="60"
# DB_WAIT_DELAY="2"
