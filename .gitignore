# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env*.local

# .env.example DEVE ser versionado (só valores de exemplo, nenhum segredo)
!.env.example

# Biblioteca de mídia em desenvolvimento (MEDIA_ROOT padrão = var/uploads/) — BACKOFFICE §4.4
/var/

# ------------------------------------------------------------------------------
# Segredos e dados locais — NADA disso pode ir para o GitHub
# ------------------------------------------------------------------------------

# chaves privadas e certificados
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# backups e dumps de banco (pg_dump contém dados reais de usuários)
backups/
*.sql
*.dump
*.backup
# ...exceto as migrations do Prisma, que fazem parte do código
!prisma/migrations/**/migration.sql

# logs
*.log
logs/

# cache/config local de ferramentas (contém dados pessoais do dono da máquina)
.impeccable/

# mockups de referência com dados pessoais (nome do dono na tela) — não usados pelo app
/public/lessons/art/ChatGPT Image*.png

# Pipeline de áudio (scripts/audio): o Python e os modelos ficam só na máquina de quem gera os MP3
/scripts/audio/.venv/
/scripts/audio/modelos/
__pycache__/
*.pyc

# Planejamento interno do plano v2 (briefings com caminhos locais): fica só na máquina
/docs/plano-v2/
